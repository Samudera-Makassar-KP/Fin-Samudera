rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Custom claim `role` di-set server-side lewat Admin SDK (functions/index.js,
    // syncUserDirectoryOnWrite) setiap kali /users/{uid} ditulis -- BUKAN
    // firestore.get() dari dalam rules ini (mekanisme itu TERBUKTI tidak
    // berfungsi di produksi, lihat catatan ROLLBACK DARURAT di bawah). Token
    // client baru bawa claim terbaru setelah refresh (otomatis ~1 jam sekali,
    // atau re-login) -- kalau baru saja naik jadi Super Admin dan rule ini
    // belum "melihatnya", itu batasan bawaan custom claims, bukan bug.
    function isSuperAdminRole() {
      return signedIn() && request.auth.token.role == 'Super Admin';
    }

    function validPdfUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Bukti pengembalian dana LPJ boleh PDF atau foto (JPG/PNG) -- beda dari
    // validPdfUpload() karena file ini TIDAK digabung/dikonversi jadi PDF
    // (butuh tetap dalam bentuk asli supaya OCR Cloud Vision baca isinya).
    function validPdfOrImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }

    // ROLLBACK DARURAT (2026-09-02): versi sebelumnya di sini memakai
    // firestore.get()/firestore.exists() (cross-service rules) untuk
    // memvalidasi kepemilikan dokumen (isOwnerOfDisplayId) & role elevated
    // (isElevatedRole/isSuperAdminRole) sebelum mengizinkan upload. Setelah
    // deploy, TERBUKTI DI PRODUKSI mekanisme cross-service ini tidak bekerja
    // sama sekali -- bahkan setelah data Firestore-nya dikonfirmasi 100% benar
    // (uid pemilik cocok persis), upload tetap ditolak 403. Karena ini
    // memblokir SEMUA generate/cetak PDF (Print BS/RBS/LPJ, Reminder Finance)
    // untuk SEMUA user termasuk Super Admin, langsung di-rollback ke bentuk
    // signedIn() sederhana (sama seperti sebelum Bagian K) supaya aplikasi
    // berfungsi normal lagi. Validasi tipe/ukuran file (request.resource,
    // TIDAK butuh cross-service) tetap dipertahankan karena itu terbukti jalan.
    // Perlindungan ROLE (siapa Super Admin dkk) sudah diperbaiki pakai custom
    // claims (isSuperAdminRole() di atas, lihat pemakaiannya di announcements/).
    // Perlindungan KEPEMILIKAN per-dokumen (siapa boleh timpa lampiran/PDF
    // path INI) untuk path di bawah (Reimbursement/BonSementara/LPJ/
    // lampiran_lpj) MASIH belum diperbaiki -- custom claims cocok untuk role
    // (jarang berubah, cocok ditaruh di token) tapi TIDAK cocok untuk
    // kepemilikan per-dokumen (terlalu dinamis). Opsi yang masih perlu
    // dikerjakan: upload lampiran lewat Cloud Function (Admin SDK) yang
    // validasi kepemilikan via query Firestore biasa (BUKAN cross-service,
    // terbukti selalu bekerja) sebelum menulis ke Storage -- lihat
    // SUMMARY_PENGEMBANGAN.md Bagian S untuk detail rencana.
    match /Reimbursement/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && validPdfUpload();
    }

    match /BonSementara/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && validPdfUpload();
    }

    match /LPJ/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && validPdfUpload();
    }

    match /lampiran_lpj/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && validPdfUpload();
    }

    match /lpj_pengembalian/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && validPdfOrImageUpload();
    }

    // Gambar pengumuman -- dulu dibatasi Super Admin lewat firestore.get()
    // cross-service (Bagian K/21.7), terbukti tidak bekerja, sempat dibuka
    // sementara ke signedIn() saja (rollback darurat). Sekarang dikembalikan
    // ke Super Admin-only pakai custom claim role (isSuperAdminRole() di atas),
    // yang TIDAK bergantung ke firestore.get() dari dalam rules.
    match /announcements/{fileName} {
      allow read: if signedIn();
      allow write: if isSuperAdminRole() && validImageUpload();
      allow delete: if isSuperAdminRole();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
