rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc(uid) {
      return exists(userPath(uid));
    }

    function isSuperAdmin() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && get(userPath(request.auth.uid)).data.role == 'Super Admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Reviewer/Validator/Admin/Super Admin -- role yang berhak melihat daftar
    // pengajuan orang lain (dipakai BsCheck.jsx, ReimbursementCheck.jsx,
    // LpjBsCheck.jsx untuk tab "Disetujui" / tab Super Admin, yang query-nya
    // TIDAK difilter per-uid, hanya difilter di JS setelah data diterima).
    function isElevatedRole() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && get(userPath(request.auth.uid)).data.role in ['Reviewer', 'Validator', 'Admin', 'Super Admin'];
    }

    function validString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validStringList(value, maxItems) {
      return value is list
        && value.size() <= maxItems;
    }

    function validUserRole(role) {
      return role in ['Employee', 'Validator', 'Reviewer', 'Admin', 'Super Admin'];
    }

    function validUserDocument(data) {
      return validString(data.uid, 128)
        && validString(data.nama, 120)
        && validString(data.email, 254)
        && validUserRole(data.role)
        && validOptionalString(data.posisi, 80)
        && validOptionalString(data.bankName, 80)
        && validOptionalString(data.accountNumber, 80)
        && validStringList(data.unit, 20)
        && validStringList(data.department, 20)
        && validStringList(data.validator, 20)
        && validStringList(data.reviewer1, 20)
        && validStringList(data.reviewer2, 20)
        && validStringList(data.lokasi, 20)
        && validStringList(data.platKendaraan, 20);
    }

    function isWorkflowOwner(data) {
      return signedIn()
        && data.user is map
        && data.user.uid == request.auth.uid;
    }

    function hasUserList(data, field) {
      return data.user is map
        && field in data.user.keys()
        && data.user[field] is list
        && request.auth.uid in data.user[field];
    }

    function isWorkflowApprover(data) {
      return signedIn()
        && (
          hasUserList(data, 'validator')
          || hasUserList(data, 'reviewer1')
          || hasUserList(data, 'reviewer2')
        );
    }

    function isCurrentApprover(data) {
      return signedIn()
        && data.currentApproverUid is string
        && data.currentApproverUid == request.auth.uid;
    }

    function canReadWorkflow(data) {
      return signedIn()
        && (
          isSuperAdmin()
          || isWorkflowOwner(data)
          || isWorkflowApprover(data)
          || isCurrentApprover(data)
        );
    }

    function validWorkflowCreate(data) {
      return data.user is map
        && data.user.uid is string
        && data.user.uid.size() > 0
        && validOptionalString(data.displayId, 80)
        && validOptionalString(data.status, 80);
    }

    function keepsWorkflowIdentity() {
      return request.resource.data.user is map
        && resource.data.user is map
        && request.resource.data.user.uid == resource.data.user.uid
        && request.resource.data.displayId == resource.data.displayId;
    }

    function canCreateWorkflow(data) {
      return signedIn()
        && validWorkflowCreate(data)
        && (isSuperAdmin() || data.user.uid == request.auth.uid);
    }

    function workflowStatusUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'statusHistory',
        'approvedByValidator',
        'approvedByValidatorStatus',
        'approvedByReviewer1',
        'approvedByReviewer1Status',
        'approvedByReviewer2',
        'approvedByReviewer2Status',
        'approvedBySuperAdmin',
        'rejectedBySuperAdmin',
        'rejectReason'
      ]);
    }

    function ownerCancelKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'cancelReason',
        'statusHistory'
      ]);
    }

    function canCancelOwnWorkflow() {
      return isWorkflowOwner(resource.data)
        && resource.data.status == 'Diajukan'
        && request.resource.data.status == 'Dibatalkan'
        && ownerCancelKeysOnly()
        && validOptionalString(request.resource.data.cancelReason, 500);
    }

    function canApproverUpdateWorkflow() {
      return (isWorkflowApprover(resource.data) || isCurrentApprover(resource.data))
        && workflowStatusUpdateKeysOnly();
    }

    // Menandai pengajuan yang sudah Disetujui sebagai sudah di-TF finance
    // (tombol "Transferred" di ReimbursementTable.jsx). Hanya menambahkan
    // `transferred`/`transferredAt`, satu arah (tidak bisa di-un-set balik).
    function canMarkTransferred() {
      return isWorkflowOwner(resource.data)
        && resource.data.status == 'Disetujui'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transferred', 'transferredAt'])
        && request.resource.data.transferred == true;
    }

    function canUpdateWorkflow() {
      return signedIn()
        && keepsWorkflowIdentity()
        && (
          isSuperAdmin()
          || canCancelOwnWorkflow()
          || canApproverUpdateWorkflow()
          || canMarkTransferred()
        );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if (
        isSuperAdmin() && request.resource.data.uid == uid && validUserDocument(request.resource.data)
      ) || (
        isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankName', 'accountNumber'])
        && validOptionalString(request.resource.data.bankName, 80)
        && validOptionalString(request.resource.data.accountNumber, 80)
      );
      allow delete: if false;
    }

    match /drafts/{draftId} {
      // get/create/update/delete: dievaluasi per dokumen tunggal, regex boleh dipakai di sini.
      allow get, create, update, delete: if signedIn()
        && draftId.matches(request.auth.uid + '_.*');

      // list: WAJIB pakai operator perbandingan range (bukan regex/matches).
      // Firestore hanya bisa membuktikan keamanan operasi "list"/query kalau
      // operator rule-nya sama dengan operator yang dipakai query itu sendiri.
      // LpjBsTable.jsx melakukan query where('__name__','>=',uid+'_') dan
      // where('__name__','<=',uid+'_\uf8ff') -- rule di bawah harus persis begitu.
      // Ini pola resmi yang direkomendasikan Firebase untuk query prefix document ID.
      allow list: if signedIn()
        && draftId >= request.auth.uid + '_'
        && draftId < request.auth.uid + '_\uf8ff';
    }

    match /counters/{counterId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Nomor urut BS/RBS/LPJ. FormBs.jsx menulis ID dokumen counter '{unitCode}',
    // sedangkan FormRbsBbm.jsx / FormRbsOperasional.jsx / FormRbsUmum.jsx /
    // FormLpjUmum.jsx / FormLpjMarketing.jsx menulis ID '{unitCode}_<TIPE>' (mis.
    // 'SMDR_RBS_BBM') supaya counter tiap tipe dokumen independen -- BEDA dari
    // /counters di atas. Tanpa rule ini, pembuatan nomor baru akan gagal
    // permission-denied walau tidak terlihat di error LPJ ini.
    match /businessUnitCounters/{counterId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /bonSementara/{docId} {
      // get: dokumen tunggal, tetap ketat lewat canReadWorkflow.
      allow get: if canReadWorkflow(resource.data);

      // list: query broad (status saja, tanpa filter uid) dipakai tab "Disetujui"
      // & tab Super Admin -- Firestore tidak bisa membuktikan canReadWorkflow untuk
      // query semacam itu, jadi elevated role diberi akses list lebih longgar.
      // Employee tetap aman karena query mereka (LpjBsTable dkk.) sudah difilter
      // where('user.uid','==',uid) yang cocok persis dengan isWorkflowOwner.
      allow list: if isElevatedRole()
        || (signedIn() && resource.data.user.uid == request.auth.uid);

      allow create: if canCreateWorkflow(request.resource.data);
      allow update: if canUpdateWorkflow();
      allow delete: if isSuperAdmin();
    }

    match /reimbursement/{docId} {
      allow get: if canReadWorkflow(resource.data);
      allow list: if isElevatedRole()
        || (signedIn() && resource.data.user.uid == request.auth.uid);
      allow create: if canCreateWorkflow(request.resource.data);
      allow update: if canUpdateWorkflow();
      allow delete: if isSuperAdmin();
    }

    match /lpj/{docId} {
      allow get: if canReadWorkflow(resource.data);
      allow list: if isElevatedRole()
        || (signedIn() && resource.data.user.uid == request.auth.uid);
      allow create: if canCreateWorkflow(request.resource.data);
      allow update: if canUpdateWorkflow();
      allow delete: if isSuperAdmin();
    }

    // Pengumuman (dipakai AnnouncementPopup.jsx). Sebelumnya tidak didefinisikan
    // sama sekali sehingga jatuh ke deny-all paling bawah -> permission-denied.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Koleksi alert (dipakai BSAlerts.jsx). SESUAIKAN nama koleksi di bawah
    // ('alerts') dengan nama asli yang dipakai di BSAlerts.jsx kalau berbeda --
    // cek baris `collection(db, '...')` di file itu.
    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}