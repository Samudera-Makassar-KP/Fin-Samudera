rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc(uid) {
      return exists(userPath(uid));
    }

    function isSuperAdmin() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && get(userPath(request.auth.uid)).data.role == 'Super Admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Reviewer/Validator/Admin/Super Admin -- role yang berhak melihat daftar
    // pengajuan orang lain (dipakai BsCheck.jsx, ReimbursementCheck.jsx,
    // LpjBsCheck.jsx untuk tab "Disetujui" / tab Super Admin, yang query-nya
    // TIDAK difilter per-uid, hanya difilter di JS setelah data diterima).
    function isElevatedRole() {
      return signedIn()
        && hasUserDoc(request.auth.uid)
        && get(userPath(request.auth.uid)).data.role in ['Reviewer', 'Validator', 'Admin', 'Super Admin'];
    }

    function validString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validStringList(value, maxItems) {
      return value is list
        && value.size() <= maxItems;
    }

    function validUserRole(role) {
      return role in ['Employee', 'Validator', 'Reviewer', 'Admin', 'Super Admin'];
    }

    function validUserDocument(data) {
      return validString(data.uid, 128)
        && validString(data.nama, 120)
        && validString(data.email, 254)
        && validUserRole(data.role)
        && validOptionalString(data.posisi, 80)
        && validOptionalString(data.bankName, 80)
        && validOptionalString(data.accountNumber, 80)
        && validStringList(data.unit, 20)
        && validStringList(data.department, 20)
        && validStringList(data.validator, 20)
        && validStringList(data.reviewer1, 20)
        && validStringList(data.reviewer2, 20)
        && validStringList(data.lokasi, 20)
        && validStringList(data.platKendaraan, 20);
    }

    function isWorkflowOwner(data) {
      return signedIn()
        && data.user is map
        && data.user.uid == request.auth.uid;
    }

    function hasUserList(data, field) {
      return data.user is map
        && field in data.user.keys()
        && data.user[field] is list
        && request.auth.uid in data.user[field];
    }

    function isWorkflowApprover(data) {
      return signedIn()
        && (
          hasUserList(data, 'validator')
          || hasUserList(data, 'reviewer1')
          || hasUserList(data, 'reviewer2')
        );
    }

    function isCurrentApprover(data) {
      return signedIn()
        && data.currentApproverUid is string
        && data.currentApproverUid == request.auth.uid;
    }

    function canReadWorkflow(data) {
      return signedIn()
        && (
          isSuperAdmin()
          || isWorkflowOwner(data)
          || isWorkflowApprover(data)
          || isCurrentApprover(data)
        );
    }

    // Daftar approver (validator/reviewer1/reviewer2) opsional tergantung modul
    // (mis. BS tidak punya 'validator'), tapi kalau ada HARUS berupa list -- bukan
    // sekadar string/uid tunggal yang bisa dipalsukan jadi apa saja.
    function validApproverList(list) {
      return list == null || (list is list && list.size() <= 5);
    }

    function validWorkflowCreate(data) {
      return data.user is map
        && data.user.uid is string
        && data.user.uid.size() > 0
        && validOptionalString(data.displayId, 80)
        // WAJIB 'Diajukan' -- sebelumnya validOptionalString(data.status, 80)
        // mengizinkan STRING APA PUN termasuk 'Disetujui', jadi klien yang
        // menulis langsung ke Firestore (bypass UI resmi) bisa membuat dokumen
        // yang langsung berstatus disetujui tanpa melalui approval sama sekali.
        // Semua form (FormBs.jsx, FormRbsUmum/Operasional/Bbm.jsx,
        // FormLpjUmum/Marketing.jsx) selalu create dengan status: 'Diajukan'.
        && data.status == 'Diajukan'
        // .get(key, default) WAJIB dipakai, bukan data.user.validator langsung --
        // BS (FormBs.jsx) tidak pernah menyertakan key 'validator' sama sekali di
        // objek user-nya, dan mengakses key map yang tidak ada lewat dot-notation
        // membuat evaluasi rule ERROR (dianggap deny), bukan mengembalikan null.
        && validApproverList(data.user.get('validator', null))
        && validApproverList(data.user.get('reviewer1', null))
        && validApproverList(data.user.get('reviewer2', null));
    }

    function keepsWorkflowIdentity() {
      return request.resource.data.user is map
        && resource.data.user is map
        && request.resource.data.user.uid == resource.data.user.uid
        && request.resource.data.displayId == resource.data.displayId;
    }

    function canCreateWorkflow(data) {
      return signedIn()
        && validWorkflowCreate(data)
        && (isSuperAdmin() || data.user.uid == request.auth.uid);
    }

    function workflowStatusUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'statusHistory',
        'approvedByValidator',
        'approvedByValidatorStatus',
        'approvedByReviewer1',
        'approvedByReviewer1Status',
        'approvedByReviewer2',
        'approvedByReviewer2Status',
        'approvedBySuperAdmin',
        'rejectedBySuperAdmin',
        'rejectReason'
      ]);
    }

    function ownerCancelKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'cancelReason',
        'statusHistory'
      ]);
    }

    function canCancelOwnWorkflow() {
      return isWorkflowOwner(resource.data)
        && resource.data.status == 'Diajukan'
        && request.resource.data.status == 'Dibatalkan'
        && ownerCancelKeysOnly()
        && validOptionalString(request.resource.data.cancelReason, 500);
    }

    // Transisi status maju yang sah dalam alur approval (dipakai bareng workflow
    // 2 tahap seperti BS: Diajukan->Diproses->Disetujui, maupun 3 tahap seperti
    // RBS/LPJ: Diajukan->Divalidasi->Diproses->Disetujui). 'Ditolak' TIDAK
    // dibatasi dari status mana asalnya di sini -- itu sudah dijaga di sisi
    // aplikasi (lihat handleSubmitReject) dan tetap mensyaratkan pelaku ada di
    // daftar validator/reviewer1/reviewer2 dokumen tsb (isWorkflowApprover).
    function isValidForwardTransition(fromStatus, toStatus) {
      return (fromStatus == 'Diajukan' && (toStatus == 'Divalidasi' || toStatus == 'Diproses'))
        || (fromStatus == 'Divalidasi' && toStatus == 'Diproses')
        || (fromStatus == 'Diproses' && toStatus == 'Disetujui');
    }

    function canApproverUpdateWorkflow() {
      return (isWorkflowApprover(resource.data) || isCurrentApprover(resource.data))
        && workflowStatusUpdateKeysOnly()
        // Sebelumnya tidak ada pengecekan ini -- seorang approver (mis.
        // Validator) yang lolos workflowStatusUpdateKeysOnly() bisa saja
        // mengirim request yang direkayasa untuk melompat langsung ke status
        // 'Disetujui', melewati Reviewer 1/2. Sekarang transisi maju wajib
        // sah lewat isValidForwardTransition(); reject ('Ditolak') tetap bebas
        // dari status manapun (lihat komentar di atas).
        && (
          request.resource.data.status == 'Ditolak'
          || isValidForwardTransition(resource.data.status, request.resource.data.status)
        );
    }

    // Menandai pengajuan yang sudah Disetujui sebagai sudah di-TF finance
    // (tombol "Transferred" di ReimbursementTable.jsx). Hanya menambahkan
    // `transferred`/`transferredAt`, satu arah (tidak bisa di-un-set balik).
    function canMarkTransferred() {
      return isWorkflowOwner(resource.data)
        && resource.data.status == 'Disetujui'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transferred', 'transferredAt'])
        && request.resource.data.transferred == true;
    }

    function canUpdateWorkflow() {
      return signedIn()
        && keepsWorkflowIdentity()
        && (
          isSuperAdmin()
          || canCancelOwnWorkflow()
          || canApproverUpdateWorkflow()
          || canMarkTransferred()
        );
    }

    // Sebelumnya `allow read: if signedIn()` -- SIAPA PUN yang login bisa baca
    // profil LENGKAP user lain, termasuk bankName/accountNumber (nomor rekening
    // bank asli), lewat query langsung ke Firestore (bypass UI resmi). Rule ini
    // sengaja tetap longgar sebelumnya karena beberapa fitur legit (dropdown
    // Reviewer/Validator, dropdown plat BBM lintas user, nama approver di
    // PDF/Detail) butuh baca lintas-user -- tapi semuanya cuma butuh nama/role/
    // unit/plat, TIDAK PERNAH butuh data bank. Fitur-fitur itu sekarang baca
    // dari /userDirectory (mirror read-only, field aman saja, lihat
    // functions/index.js syncUserDirectoryOnWrite) -- lihat Bagian H/18.4.
    //
    // - get: pemilik profil sendiri, atau Super Admin (satu-satunya role yang
    //   punya halaman Manage User & butuh lihat/edit profil lengkap orang lain).
    // - list: Super Admin (Manage User, Tambah/Edit Pengguna, Ekspor Laporan),
    //   ATAU query yang provably discope ke email milik requester sendiri
    //   (dipakai Login.jsx sebagai fallback saat doc ID user tidak sama dengan
    //   uid Firebase Auth-nya -- kasus migrasi akun lama).
    match /users/{uid} {
      allow get: if isSelf(uid) || isSuperAdmin();
      allow list: if isSuperAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if false;
      allow update: if (
        isSuperAdmin() && request.resource.data.uid == uid && validUserDocument(request.resource.data)
      ) || (
        isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankName', 'accountNumber'])
        && validOptionalString(request.resource.data.bankName, 80)
        && validOptionalString(request.resource.data.accountNumber, 80)
      );
      allow delete: if false;
    }

    // Mirror read-only dari /users -- field aman saja (nama/role/unit/plat),
    // TIDAK PERNAH bankName/accountNumber. Ditulis HANYA oleh Cloud Function
    // (Admin SDK, bypass rules ini) lewat trigger syncUserDirectoryOnWrite &
    // callable backfillUserDirectory di functions/index.js. Dibaca bebas oleh
    // siapa pun yang login untuk dropdown Reviewer/Validator/plat BBM & nama
    // approver di PDF/Detail -- lihat komentar di /users/{uid} di atas.
    match /userDirectory/{uid} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /drafts/{draftId} {
      // get/create/update/delete: dievaluasi per dokumen tunggal, regex boleh dipakai di sini.
      allow get, create, update, delete: if signedIn()
        && draftId.matches(request.auth.uid + '_.*');

      // list: WAJIB pakai operator perbandingan range (bukan regex/matches).
      // Firestore hanya bisa membuktikan keamanan operasi "list"/query kalau
      // operator rule-nya sama dengan operator yang dipakai query itu sendiri.
      // LpjBsTable.jsx melakukan query where('__name__','>=',uid+'_') dan
      // where('__name__','<=',uid+'_\uf8ff') -- rule di bawah harus persis begitu.
      // Ini pola resmi yang direkomendasikan Firebase untuk query prefix document ID.
      allow list: if signedIn()
        && draftId >= request.auth.uid + '_'
        && draftId < request.auth.uid + '_\uf8ff';
    }

    // Bentuk dokumen counter selalu {lastNumber: int >= 0, lastResetYear: "YYYY"}
    // (lihat runTransaction di FormBs.jsx dkk). Sebelumnya rule mengizinkan
    // signedIn() menulis field APA PUN dengan nilai APA PUN ke counter ini --
    // termasuk employee biasa yang bisa me-reset/menurunkan lastNumber dan
    // memicu ulang bug duplikasi nomor dokumen yang sudah diperbaiki (lihat
    // Bagian C/13.7 di SUMMARY_PENGEMBANGAN.md). Sekarang nilai & tipe field
    // divalidasi, dan lastNumber tidak boleh MENURUN kecuali lastResetYear ikut
    // berubah (reset tahun baru -- perilaku sah yang sudah ada di kode).
    function validCounterFields(data) {
      return data.keys().hasOnly(['lastNumber', 'lastResetYear'])
        && data.lastNumber is int
        && data.lastNumber >= 0
        && data.lastResetYear is string
        && data.lastResetYear.size() == 4;
    }

    function validCounterUpdate() {
      return validCounterFields(request.resource.data)
        && (
          request.resource.data.lastResetYear != resource.data.lastResetYear
          || request.resource.data.lastNumber >= resource.data.lastNumber
        );
    }

    // Koleksi lama, sudah tidak dipakai kode manapun (client maupun functions/
    // index.js) -- tetap dijaga dengan validasi bentuk yang sama, bukan
    // signedIn() bebas nilai apa pun, untuk jaga-jaga kalau dipakai lagi nanti.
    match /counters/{counterId} {
      allow read: if signedIn();
      allow create: if signedIn() && validCounterFields(request.resource.data);
      allow update: if signedIn() && validCounterUpdate();
      allow delete: if false;
    }

    // Nomor urut BS/RBS/LPJ. FormBs.jsx menulis ID dokumen counter '{unitCode}',
    // sedangkan FormRbsBbm.jsx / FormRbsOperasional.jsx / FormRbsUmum.jsx /
    // FormLpjUmum.jsx / FormLpjMarketing.jsx menulis ID '{unitCode}_<TIPE>' (mis.
    // 'SMDR_RBS_BBM') supaya counter tiap tipe dokumen independen -- BEDA dari
    // /counters di atas. Tanpa rule ini, pembuatan nomor baru akan gagal
    // permission-denied walau tidak terlihat di error LPJ ini.
    match /businessUnitCounters/{counterId} {
      allow read: if signedIn();
      allow create: if signedIn() && validCounterFields(request.resource.data);
      allow update: if signedIn() && validCounterUpdate();
      allow delete: if false;
    }

    // Indeks kepemilikan displayId -> uid. Ditulis atomik di transaksi yang sama saat
    // nomor dokumen (displayId) digenerate (lihat generateDisplayId() di form-form
    // RBS/LPJ & transaksi nomor BS di FormBs.jsx), supaya tidak ada celah antara nomor
    // dibuat dan kepemilikannya tercatat. Dipakai storage.rules (lewat firestore.get()
    // cross-service, yang bypass rules ini) untuk memvalidasi siapa yang boleh
    // upload/timpa lampiran & PDF hasil generate di path Storage yang mengandung
    // displayId tsb -- sebelumnya siapa pun yang login bisa menimpa file di path
    // manapun asal tahu/menebak displayId-nya (lihat Bagian H/18.4).
    match /displayIdOwners/{displayId} {
      allow get, list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /bonSementara/{docId} {
      // get: dokumen tunggal, tetap ketat lewat canReadWorkflow.
      allow get: if canReadWorkflow(resource.data);

      // list: query broad (status saja, tanpa filter uid) dipakai tab "Disetujui"
      // & tab Super Admin -- Firestore tidak bisa membuktikan canReadWorkflow untuk
      // query semacam itu, jadi elevated role diberi akses list lebih longgar.
      // Employee tetap aman karena query mereka (LpjBsTable dkk.) sudah difilter
      // where('user.uid','==',uid) yang cocok persis dengan isWorkflowOwner.
      allow list: if isElevatedRole()
        || (signedIn() && resource.data.user.uid == request.auth.uid);

      allow create: if canCreateWorkflow(request.resource.data);
      allow update: if canUpdateWorkflow();
      allow delete: if isSuperAdmin();
    }

    match /reimbursement/{docId} {
      allow get: if canReadWorkflow(resource.data);
      allow list: if isElevatedRole()
        || (signedIn() && resource.data.user.uid == request.auth.uid);
      allow create: if canCreateWorkflow(request.resource.data);
      allow update: if canUpdateWorkflow();
      allow delete: if isSuperAdmin();
    }

    match /lpj/{docId} {
      allow get: if canReadWorkflow(resource.data);
      allow list: if isElevatedRole()
        || (signedIn() && resource.data.user.uid == request.auth.uid);
      allow create: if canCreateWorkflow(request.resource.data);
      allow update: if canUpdateWorkflow();
      allow delete: if isSuperAdmin();
    }

    // Pengumuman (dipakai AnnouncementPopup.jsx). Sebelumnya tidak didefinisikan
    // sama sekali sehingga jatuh ke deny-all paling bawah -> permission-denied.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // Koleksi alert (dipakai BSAlerts.jsx). SESUAIKAN nama koleksi di bawah
    // ('alerts') dengan nama asli yang dipakai di BSAlerts.jsx kalau berbeda --
    // cek baris `collection(db, '...')` di file itu.
    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}